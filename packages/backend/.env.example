# ─── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://rental_user:rental_password@localhost:5432/rental_platform

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_xxxxx
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=eur
USE_MOCK_PAYMENT=false

# ─── Storage ───────────────────────────────────────────────────
STORAGE_BUCKET_URL=http://localhost:54321/storage/v1

# ─── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# ─── Frontend (used in email verification links, redirects) ────
FRONTEND_URL=http://localhost:5173

# ─── App Defaults ──────────────────────────────────────────────
DEFAULT_CITY=paris
DEFAULT_LOCALE=fr
