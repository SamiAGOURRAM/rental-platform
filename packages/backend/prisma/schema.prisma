generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  customer
  admin
  super_admin
}

enum ProductCondition {
  new
  excellent
  good
  fair
  end_of_life
}

enum ProductStatus {
  available
  reserved
  rented
  in_cleaning
  in_inspection
  retired
  donated
}

enum ProductSource {
  vinted
  wholesale
  donated_in
  direct_purchase
}

enum ProductGender {
  men
  women
  unisex
}

enum ProductSeason {
  spring_summer
  fall_winter
  all_season
}

enum OrderStatus {
  pending_payment
  confirmed
  preparing
  out_for_delivery
  delivered
  active_rental
  return_initiated
  return_in_transit
  returned
  inspecting
  completed
  cancelled
  refunded
}

enum DeliveryMethod {
  personal
  mondial_relay
  chronopost
  colissimo
}

enum DeliveryDirection {
  outbound
  return
}

enum DeliveryStatus {
  scheduled
  picked_up
  in_transit
  delivered
  failed
}

enum PaymentType {
  rental
  deposit
  damage_fee
  refund
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  partially_refunded
}

enum LifecycleEventType {
  added_to_inventory
  rented
  returned
  cleaned
  inspected
  condition_changed
  repaired
  marked_for_donation
  donated
}

enum CapsuleCategory {
  beach
  business
  city
  winter
  wedding
  casual
}

// ─────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  isGuest         Boolean   @default(false) @map("is_guest")
  emailVerified   Boolean   @default(false) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  role         UserRole @default(customer)
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  locale       String   @default("fr")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  addresses            Address[]
  orders               Order[]
  refreshTokens        RefreshToken[]
  carbonSavings        CarbonSaving[]
  orderStatusHistories OrderStatusHistory[] @relation("ChangedBy")

  @@map("users")
}

model Address {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  label        String
  line1        String
  line2        String?
  city         String
  postalCode   String  @map("postal_code")
  countryCode  String  @map("country_code") @default("FR")
  instructions String?
  isDefault    Boolean @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

enum VerificationTokenType {
  email_verify
  password_reset
  magic_link
}

model VerificationToken {
  id        String                @id @default(uuid())
  userId    String                @map("user_id")
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash")
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("verification_tokens")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  tokenHash   String    @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  rotatedToId String?   @map("rotated_to_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id])
  rotatedTo   RefreshToken? @relation("TokenRotation", fields: [rotatedToId], references: [id])
  rotatedFrom RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id        String  @id @default(uuid())
  slug      String  @unique
  nameEn    String  @map("name_en")
  nameFr    String  @map("name_fr")
  nameEs    String  @map("name_es")
  parentId  String? @map("parent_id")
  sortOrder Int     @default(0) @map("sort_order")
  icon      String?

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  products Product[]
  capsuleItems CapsuleWardrobeItem[]

  @@map("categories")
}

model Product {
  id                 String           @id @default(uuid())
  categoryId         String           @map("category_id")
  sku                String           @unique
  nameEn             String           @map("name_en")
  nameFr             String           @map("name_fr")
  nameEs             String           @map("name_es")
  descriptionEn      String           @map("description_en")
  descriptionFr      String           @map("description_fr")
  descriptionEs      String           @map("description_es")
  brand              String
  sizeEu             String           @map("size_eu")
  sizeUk             String?          @map("size_uk")
  sizeUs             String?          @map("size_us")
  color              String
  material           String?
  weightGrams        Int              @map("weight_grams")
  gender             ProductGender
  season             ProductSeason
  condition          ProductCondition @default(new)
  cycleCount         Int              @default(0) @map("cycle_count")
  maxCycles          Int              @map("max_cycles")
  purchasePrice      Decimal          @map("purchase_price") @db.Decimal(10, 2)
  rentalPricePerDay  Decimal          @map("rental_price_per_day") @db.Decimal(10, 2)
  source             ProductSource
  status             ProductStatus    @default(available)
  city               String           @default("paris")
  metadata           Json?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  retiredAt          DateTime?        @map("retired_at")

  category      Category               @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  lifecycleLog  ProductLifecycleLog[]
  orderItems    OrderItem[]
  inventoryUnits InventoryUnit[]

  @@index([status, city])
  @@index([categoryId, gender, season])
  @@index([sizeEu])
  @@map("products")
}

// ─────────────────────────────────────────────────────────────
// Inventory Units — physical copies of a Product living in a city
// A Product with 5 copies across Paris(3) + Nice(2) = 5 units.
// ─────────────────────────────────────────────────────────────

model InventoryUnit {
  id          String           @id @default(uuid())
  productId   String           @map("product_id")
  city        String           @default("paris")
  status      ProductStatus    @default(available)
  condition   ProductCondition @default(new)
  cycleCount  Int              @default(0) @map("cycle_count")
  createdAt   DateTime         @default(now()) @map("created_at")
  retiredAt   DateTime?        @map("retired_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId, city, status])
  @@index([city, status])
  @@map("inventory_units")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("product_images")
}

model ProductLifecycleLog {
  id          String             @id @default(uuid())
  productId   String             @map("product_id")
  eventType   LifecycleEventType @map("event_type")
  orderId     String?            @map("order_id")
  notes       String?
  performedBy String             @map("performed_by")
  createdAt   DateTime           @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@map("product_lifecycle_log")
}

// ─────────────────────────────────────────────────────────────
// Capsule Wardrobes
// ─────────────────────────────────────────────────────────────

model CapsuleWardrobe {
  id             String          @id @default(uuid())
  slug           String          @unique
  nameEn         String          @map("name_en")
  nameFr         String          @map("name_fr")
  nameEs         String          @map("name_es")
  descriptionEn  String          @map("description_en")
  descriptionFr  String          @map("description_fr")
  descriptionEs  String          @map("description_es")
  categoryType   CapsuleCategory @map("category_type")
  season         ProductSeason
  gender         ProductGender
  basePrice      Decimal         @map("base_price") @db.Decimal(10, 2)
  imageUrl       String?         @map("image_url")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")

  items CapsuleWardrobeItem[]

  @@map("capsule_wardrobes")
}

model CapsuleWardrobeItem {
  id         String  @id @default(uuid())
  capsuleId  String  @map("capsule_id")
  categoryId String  @map("category_id")
  quantity   Int     @default(1)
  isRequired Boolean @default(true) @map("is_required")

  capsule  CapsuleWardrobe @relation(fields: [capsuleId], references: [id])
  category Category        @relation(fields: [categoryId], references: [id])

  @@unique([capsuleId, categoryId])
  @@map("capsule_wardrobe_items")
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  addressId       String      @map("address_id")
  orderNumber     String      @unique @map("order_number")
  status          OrderStatus @default(pending_payment)
  rentalStart     DateTime    @map("rental_start") @db.Date
  rentalEnd       DateTime    @map("rental_end") @db.Date
  deliveryMethod  DeliveryMethod @map("delivery_method")
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  depositAmount   Decimal     @default(0) @map("deposit_amount") @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  currency        String      @default("eur")
  carbonSavedKg   Decimal?    @map("carbon_saved_kg") @db.Decimal(10, 3)
  locale          String      @default("fr")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id])
  address       Address              @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  deliveries    Delivery[]
  carbonSaving  CarbonSaving?
  lifecycleLog  ProductLifecycleLog[]

  @@index([userId])
  @@index([rentalStart, rentalEnd])
  @@map("orders")
}

model OrderItem {
  id              String           @id @default(uuid())
  orderId         String           @map("order_id")
  productId       String           @map("product_id")
  quantity        Int              @default(1)
  city            String           @default("paris")
  unitIds         Json?            @map("unit_ids")
  priceAtTime     Decimal          @map("price_at_time") @db.Decimal(10, 2)
  conditionAtRent ProductCondition @map("condition_at_rent")
  cycleAtRent     Int              @map("cycle_at_rent")

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productId, city])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  changedBy  String       @map("changed_by")
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at")

  order  Order @relation(fields: [orderId], references: [id])
  actor  User  @relation("ChangedBy", fields: [changedBy], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// ─────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @map("order_id")
  stripeSessionId      String?       @unique @map("stripe_session_id")
  stripePaymentIntent  String?       @map("stripe_payment_intent")
  type                 PaymentType
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("eur")
  status               PaymentStatus @default(pending)
  idempotencyKey       String        @unique @map("idempotency_key")
  metadata             Json?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────
// Deliveries
// ─────────────────────────────────────────────────────────────

model Delivery {
  id            String            @id @default(uuid())
  orderId       String            @map("order_id")
  type          DeliveryMethod
  direction     DeliveryDirection
  status        DeliveryStatus    @default(scheduled)
  trackingCode  String?           @map("tracking_code")
  carrier       String?
  scheduledAt   DateTime          @map("scheduled_at")
  pickedUpAt    DateTime?         @map("picked_up_at")
  deliveredAt   DateTime?         @map("delivered_at")
  fee           Decimal           @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([scheduledAt, status])
  @@map("deliveries")
}

// ─────────────────────────────────────────────────────────────
// Carbon Savings
// ─────────────────────────────────────────────────────────────

model CarbonSaving {
  id                  String  @id @default(uuid())
  userId              String  @map("user_id")
  orderId             String  @unique @map("order_id")
  luggageCo2Kg        Decimal @map("luggage_co2_kg") @db.Decimal(10, 3)
  reuseCo2Kg          Decimal @map("reuse_co2_kg") @db.Decimal(10, 3)
  totalCo2Kg          Decimal @map("total_co2_kg") @db.Decimal(10, 3)
  itemsReused         Int     @map("items_reused")
  weightAvoidedKg     Decimal @map("weight_avoided_kg") @db.Decimal(10, 3)
  calculationVersion  Int     @default(1) @map("calculation_version")
  createdAt           DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@map("carbon_savings")
}
